# generated by scripts/gen-redirects.mjs — do not hand-edit

# old WordPress category archives, tags and feeds
/category/*    /:splat    301
/tag/*    /blog    301
/feed    /blog    301
/feed/*    /blog    301

# link-building posts: /seo-backlinks/... -> /seo/backlinks/...
/seo-backlinks    /seo/backlinks    301
/seo-backlinks/*    /seo/backlinks/:splat    301

# old WordPress page slugs
/about-us    /about    301
/about-us/   /about    301
/seo-specialist-service    /hire-seo-specialist    301
/seo-specialist-service/   /hire-seo-specialist    301
/career    /careers    301
/career/   /careers    301
/privacy-policy    /privacy    301
/privacy-policy/   /privacy    301
/terms-and-conditions    /terms    301
/terms-and-conditions/   /terms    301

# NOTE: trailing-slash canonicalisation (/path/ -> /path) is handled
# natively by Cloudflare Pages because astro.config build.format is 'file'
# (every page is emitted as path.html, not path/index.html).

# NOTE: per-post flat URLs (/{slug}, /blog/{slug}) are handled by
# src/pages/[...oldpost].astro + src/pages/blog/[slug].astro redirect
# pages, and by bulk-redirects.csv (Cloudflare -> Bulk Redirects).
