---
import "../../styles/global.css";
import Favicons from "../../components/Favicons.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostCard from "../../components/PostCard.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { getAllPosts, postPath } from "../../lib/posts";
import { listAuthors, getAuthor, authorInitials } from "../../lib/authors";
import { localImage } from "../../lib/images";
import JsonLd from "../../components/JsonLd.astro";
import {
  abs,
  webPageNode,
  breadcrumbNode,
  personNode,
  itemListNode,
} from "../../lib/schema";

export function getStaticPaths() {
  return listAuthors().map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { slug } = Astro.params;
const { author } = Astro.props;

const allPosts = await getAllPosts();
const authored = allPosts.filter((p) => {
  const a = getAuthor(p.author?.node?.slug, p.author?.node?.name);
  return a.slug === slug;
});
const posts = (authored.length ? authored : allPosts).slice(0, 6);

const pageUrl = abs(`/author/${author.slug}`);
const authorSameAs = Object.entries(author.socials ?? {})
  .filter(([k, v]) => v && k !== "email" && String(v).startsWith("http"))
  .map(([, v]) => String(v));
const graph = [
  webPageNode({
    url: pageUrl,
    name: `${author.name}, author at SERP Mentor`,
    description: author.bio,
    type: "ProfilePage",
  }),
  breadcrumbNode(pageUrl, [
    { name: "Home", item: abs("/") },
    { name: author.name },
  ]),
  personNode({
    url: pageUrl,
    name: author.name,
    jobTitle: author.title,
    description: author.bio,
    image: author.image ? abs(localImage(author.image)) : undefined,
    sameAs: authorSameAs,
  }),
  itemListNode(
    pageUrl,
    authored.map((p) => ({ url: abs(postPath(p)), name: p.title })),
    `Articles by ${author.name}`,
  ),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>{author.name}, author at SERP Mentor</title>
    <meta name="description" content={author.bio} />
    <link rel="canonical" href={`/author/${author.slug}`} />
    <JsonLd graph={graph} />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="page-header">
        <div class="container">
          <div class="author-hero">
            <span class="author-hero-avatar">
              {
                author.image ? (
                  <img src={localImage(author.image)} alt={author.name} width="96" height="96" />
                ) : (
                  <span>{authorInitials(author.name)}</span>
                )
              }
            </span>
            <div>
              <p class="eyebrow">Author</p>
              <h1>{author.name}</h1>
              <p class="author-hero-title">{author.title}</p>
              <p class="author-hero-bio">{author.bio}</p>
              <SocialLinks socials={author.socials} label="Follow" />
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>{authored.length ? "Articles by " + author.name : "Latest articles"}</h2>
              <p>
                {authored.length
                  ? `${authored.length} published`
                  : "From across the SERP Mentor blog"}
              </p>
            </div>
            <a href="/blog">View all →</a>
          </div>
          <div class="post-grid">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
