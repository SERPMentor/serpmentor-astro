---
import "../../styles/global.css";
import Favicons from "../../components/Favicons.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostCard from "../../components/PostCard.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getAllPosts, getCategories, categoryPath, postPath } from "../../lib/posts";
import JsonLd from "../../components/JsonLd.astro";
import { abs, webPageNode, breadcrumbNode, itemListNode, ORG_ID } from "../../lib/schema";

const posts = await getAllPosts();
const categories = await getCategories();

const featured = posts[0] ?? null;
const archive = posts.slice(1);

const pageUrl = abs("/blog");
const blogDescription =
  "Learn practical SEO, content strategy, AI search visibility, and growth systems from SERP Mentor.";
const graph = [
  webPageNode({
    url: pageUrl,
    name: "SEO Blog | SERP Mentor",
    description: blogDescription,
    type: "CollectionPage",
  }),
  {
    "@type": "Blog",
    "@id": `${pageUrl}#blog`,
    name: "SERP Mentor Blog",
    description: blogDescription,
    url: pageUrl,
    isPartOf: { "@id": `${pageUrl}#webpage` },
    publisher: { "@id": ORG_ID },
  },
  breadcrumbNode(pageUrl, [{ name: "Home", item: abs("/") }, { name: "Blog" }]),
  itemListNode(
    pageUrl,
    posts.slice(0, 20).map((p) => ({ url: abs(postPath(p)), name: p.title })),
    "Latest articles",
  ),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>SEO Blog | SERP Mentor</title>
    <meta
      name="description"
      content="Learn practical SEO, content strategy, AI search visibility, and growth systems from SERP Mentor."
    />
    <JsonLd graph={graph} />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="page-header">
        <div class="container narrow">
          <p class="eyebrow">Research and strategy</p>
          <h1>SEO, AI visibility, and content strategy that actually works.</h1>
          <p>
            Case studies, framework deep-dives, tool reviews, and research on how search and discovery 
            are evolving. Built for founders, marketing leaders, and in-house SEO teams serious about growth.
          </p>
          <div class="category-pills" style="margin-top:1rem;">
            {categories.map((category) => (
              <a href={categoryPath(category.slug)}>{category.name} ({category.count})</a>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container blog-layout">
          <div class="blog-list">
            {featured && (
              <PostCard post={featured} featured kicker="Featured" cta="Read the full article →" />
            )}
            {archive.map((post) => <PostCard post={post} />)}
          </div>

          <aside class="blog-sidebar">
            <div class="sidebar-panel">
              <h4>Browse by topic</h4>
              <ul>
                {categories.map((category) => (
                  <li>
                    <a href={categoryPath(category.slug)}>
                      {category.name} ({category.count})
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="sidebar-panel">
              <h4>Free resources</h4>
              <ul>
                <li><a href="/resources">SEO starter checklist</a></li>
                <li><a href="/resources">Content planning framework</a></li>
                <li><a href="/resources">Tool comparison guides</a></li>
              </ul>
            </div>

            <div class="sidebar-panel">
              <h4>Newsletter</h4>
              <p>Get practical SEO ideas every week.</p>
              <NewsletterForm cta="Join now" placeholder="Email address" />
            </div>
          </aside>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
