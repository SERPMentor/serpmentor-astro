---
import "../styles/global.css";
import Favicons from "../components/Favicons.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { OFFICES } from "../lib/team";

const packages = [
  {
    name: "Visibility & Growth",
    for: "Niche & content sites",
    icon: "fa-solid fa-seedling",
    color: "#00a988",
    soft: "rgba(0, 188, 152, 0.14)",
    includes: [
      "Full-niche brainstorming audit",
      "AI SEO — GEO, AEO, LLM optimization",
      "Technical SEO",
      "Competitor gap analysis",
      "Keyword research",
      "Content strategy & editorial calendar",
      "Internal linking & schema markup",
      "Manual outreach for backlinks",
      "Core Web Vitals, mobile & speed",
      "Monthly keyword ranking reports",
    ],
    results: [
      "More organic traffic and rankings",
      "Topical authority and credibility",
      "Higher ad revenue / affiliate conversions",
    ],
  },
  {
    name: "Influence Ignition",
    for: "E-commerce & Shopify",
    icon: "fa-solid fa-cart-shopping",
    color: "#8256c5",
    soft: "rgba(130, 86, 197, 0.14)",
    includes: [
      "Full store performance audit",
      "Product optimization & UX analysis",
      "Category structure improvement",
      "SEO-driven product descriptions & tags",
      "Crawl errors & canonical fixes",
      "Structured data implementation",
      "Content funnel for purchase intent",
      "E-commerce-specific link outreach",
      "Monthly keyword & traffic reports",
    ],
    results: [
      "Higher visibility and organic sales",
      "Less reliance on paid ads",
      "Better UX and brand trust",
    ],
  },
  {
    name: "Domination Digital",
    for: "Local & service businesses",
    icon: "fa-solid fa-location-dot",
    color: "#d8412c",
    soft: "rgba(241, 94, 74, 0.14)",
    includes: [
      "Website & Google Business Profile audit",
      "Local keyword & competitor research",
      "NAP consistency check",
      "Image, post & Q&A management",
      "Review generation & reputation strategy",
      "City + service keyword optimization",
      "Local link building from trusted sources",
      "Monthly GBP updates & engagement tracking",
      "Competitor tracking & improvements",
    ],
    results: [
      "Rank in Google Maps and the local 3-pack",
      "More local calls, inquiries and bookings",
      "Long-term trust in your community",
    ],
  },
];

const addOns = [
  {
    icon: "fa-solid fa-code",
    title: "Website design & build",
    text: "New sites and redesigns — fast, responsive, and built SEO-first from the first line of code.",
  },
  {
    icon: "fa-solid fa-gauge-high",
    title: "Technical SEO & speed",
    text: "Crawlability, indexation, structured data, and Core Web Vitals fixes on sites of any size.",
  },
  {
    icon: "fa-solid fa-file-lines",
    title: "Content & on-page",
    text: "Content strategy, briefs, and on-page optimization that reads well for people and answer engines.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <Favicons />
    <title>SEO Services & Pricing — Custom Plans, Real ROI | SERP Mentor</title>
    <meta
      name="description"
      content="No fixed packages. We audit your site first, then scope an SEO plan around your business, competition and goals. Three tracks: niche/content, e-commerce, and local."
    />
    <link rel="canonical" href="/services" />
    <meta property="og:title" content="SEO Services & Pricing | SERP Mentor" />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="page-header" style="--topic: rgba(0,188,152,0.14); --topic-fg: #00a988;">
        <div class="container">
          <div class="breadcrumbs">
            <a href="/">Home</a>
            <span>›</span>
            <span>Services</span>
          </div>
          <span class="card-icon pillar-icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
          <p class="eyebrow">Work with us</p>
          <h1>SEO services &amp; pricing</h1>
          <p class="pillar-intro">
            We don't sell fixed packages, because every business is different. We audit your site
            first, then scope a plan around your product, your competition and your goals — priced
            to pay for itself.
          </p>
          <div class="hero-actions">
            <a href="/contact" class="button">Book a free SEO session</a>
            <a href="#packages" class="button-secondary">See the tracks</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="cta-panel" style="max-width:820px; margin:0 auto;">
            <h3>How pricing works</h3>
            <p>
              There's no price list. Send a message on
              <a href="https://wa.me/8801912055505" target="_blank" rel="noopener noreferrer">WhatsApp (+880 1912 055505)</a>
              or email <a href="mailto:serpmentors@gmail.com">serpmentors@gmail.com</a>. We audit
              your website, look at the real situation, and quote a scope that fits.
            </p>
            <a href="/contact" class="button">Start the conversation</a>
          </div>
        </div>
      </section>

      <section class="section section-alt" id="packages">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Three tracks</h2>
              <p>Pick the one that matches your site — the scope flexes from there</p>
            </div>
          </div>
          <div class="package-grid">
            {
              packages.map((pkg) => (
                <div class="package-card" style={`--topic: ${pkg.soft}; --topic-fg: ${pkg.color};`}>
                  <span class="card-icon"><i class={pkg.icon} aria-hidden="true" /></span>
                  <h3>{pkg.name}</h3>
                  <p class="package-for">{pkg.for}</p>

                  <p class="package-label">What's included</p>
                  <ul class="check-list">
                    {pkg.includes.map((item) => <li>{item}</li>)}
                  </ul>

                  <p class="package-label">Results you can expect</p>
                  <ul class="package-results">
                    {pkg.results.map((item) => <li>{item}</li>)}
                  </ul>

                  <a href="/contact" class="button package-cta">Get started</a>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Add-on services</h2>
              <p>End-to-end support beyond the monthly work</p>
            </div>
          </div>
          <div class="feature-grid">
            {
              addOns.map((item) => (
                <div class="feature-panel">
                  <span class="card-icon"><i class={item.icon} aria-hidden="true" /></span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="split-layout">
            <div class="story-copy">
              <h2>Talk to a person first</h2>
              <p>
                Book a free consulting call. We'll look at your site together, talk through your
                goals, and tell you honestly whether we're the right fit.
              </p>
              <a href="/contact" class="button">Schedule a call</a>
            </div>
            <div class="office-list">
              {
                OFFICES.map((office) => (
                  <div class="office-card">
                    <i class="fa-solid fa-building" aria-hidden="true" />
                    <div>
                      <strong>{office.country}</strong>
                      <span>{office.address}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
