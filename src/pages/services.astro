---
import "../styles/global.css";
import Favicons from "../components/Favicons.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Faq from "../components/Faq.astro";
import SeoForecast from "../components/SeoForecast.astro";
import JsonLd from "../components/JsonLd.astro";
import HeroTrustCard from "../components/HeroTrustCard.astro";
import PageByline from "../components/PageByline.astro";
import { OFFICES } from "../lib/team";
import { whatsappUrl, CONTACT } from "../lib/site";
import { abs, webPageNode, breadcrumbNode, serviceNode, bylinePersonNodes, BYLINE_REFS } from "../lib/schema";

const svcUrl = abs("/services");
const svcDesc =
  "No fixed packages. We audit your site first, then scope an SEO plan around your business, competition and goals. Three tracks: niche/content, e-commerce, and local.";
const svcGraph = [
  { ...webPageNode({ url: svcUrl, name: "SEO Services & Pricing | SERP Mentor", description: svcDesc }), ...BYLINE_REFS },
  ...bylinePersonNodes(),
  breadcrumbNode(svcUrl, [{ name: "Home", item: abs("/") }, { name: "Services" }]),
  serviceNode({
    url: svcUrl,
    name: "SEO services",
    description: svcDesc,
    serviceType: "Search engine optimization",
  }),
];

const faqs = [
  {
    q: "Why is there no price list?",
    a: "Because the work is different for every site. We take a short call, look at your analytics, then quote a monthly or project fee based on what it actually takes. No packages you have to bend your business to fit.",
  },
  {
    q: "Is there a minimum commitment?",
    a: "Most SEO work is month to month, and we suggest giving it a three-month runway. That's roughly how long it takes to see the first movement. No long lock-in contract.",
  },
  {
    q: "Do you guarantee rankings?",
    a: "No. And you should be wary of anyone who does. What we guarantee: the work, the reasoning behind it, and honest reporting on what it produces.",
  },
  {
    q: "Can you work with our existing team or agency?",
    a: "Yes. We often act as the senior SEO lead directing your in-house content or dev team, or handle one track, like technical SEO, alongside another agency.",
  },
  {
    q: "How do we start?",
    a: "Hit any button on this page or message us on WhatsApp. We'll audit your site, talk through your goals, and tell you straight whether we're the right fit.",
  },
];

const packages = [
  {
    name: "Visibility & Growth",
    for: "Niche & content sites",
    icon: "fa-solid fa-seedling",
    color: "#00a988",
    soft: "rgba(0, 188, 152, 0.14)",
    includes: [
      "Full-niche brainstorming audit",
      "AI SEO: GEO, AEO, LLM optimization",
      "Technical SEO",
      "Competitor gap analysis",
      "Keyword research",
      "Content strategy & editorial calendar",
      "Internal linking & schema markup",
      "Manual outreach for backlinks",
      "Core Web Vitals, mobile & speed",
      "Monthly keyword ranking reports",
    ],
    results: [
      "More organic traffic and rankings",
      "Topical authority and credibility",
      "Higher ad revenue / affiliate conversions",
    ],
  },
  {
    name: "Influence Ignition",
    for: "E-commerce & Shopify",
    icon: "fa-solid fa-cart-shopping",
    color: "#8256c5",
    soft: "rgba(130, 86, 197, 0.14)",
    includes: [
      "Full store performance audit",
      "Product optimization & UX analysis",
      "Category structure improvement",
      "SEO-driven product descriptions & tags",
      "Crawl errors & canonical fixes",
      "Structured data implementation",
      "Content funnel for purchase intent",
      "E-commerce-specific link outreach",
      "Monthly keyword & traffic reports",
    ],
    results: [
      "Higher visibility and organic sales",
      "Less reliance on paid ads",
      "Better UX and brand trust",
    ],
  },
  {
    name: "Domination Digital",
    for: "Local & service businesses",
    icon: "fa-solid fa-location-dot",
    color: "#d8412c",
    soft: "rgba(241, 94, 74, 0.14)",
    includes: [
      "Website & Google Business Profile audit",
      "Local keyword & competitor research",
      "NAP consistency check",
      "Image, post & Q&A management",
      "Review generation & reputation strategy",
      "City + service keyword optimization",
      "Local link building from trusted sources",
      "Monthly GBP updates & engagement tracking",
      "Competitor tracking & improvements",
    ],
    results: [
      "Rank in Google Maps and the local 3-pack",
      "More local calls, inquiries and bookings",
      "Long-term trust in your community",
    ],
  },
];

const addOns = [
  {
    icon: "fa-solid fa-code",
    title: "Website design & build",
    text: "New sites and redesigns. Fast, responsive, and built SEO-first from the first line of code.",
  },
  {
    icon: "fa-solid fa-gauge-high",
    title: "Technical SEO & speed",
    text: "Crawlability, indexation, structured data, and Core Web Vitals fixes on sites of any size.",
  },
  {
    icon: "fa-solid fa-file-lines",
    title: "Content & on-page",
    text: "Content strategy, briefs, and on-page optimization that reads well for people and answer engines.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>SEO Services & Pricing: Custom Plans, Real ROI | SERP Mentor</title>
    <meta
      name="description"
      content="No fixed packages. We audit your site first, then scope an SEO plan around your business, competition and goals. Three tracks: niche/content, e-commerce, and local."
    />
    <link rel="canonical" href="/services" />
    <meta property="og:title" content="SEO Services & Pricing | SERP Mentor" />
    <JsonLd graph={svcGraph} />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="page-header page-header-split" style="--topic: rgba(0,188,152,0.14); --topic-fg: #00a988;">
        <div class="container">
          <div>
            <div class="breadcrumbs">
              <a href="/">Home</a>
              <span>›</span>
              <span>Services</span>
            </div>
            <span class="card-icon pillar-icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
            <p class="eyebrow">Work with us</p>
            <h1>SEO services &amp; pricing</h1>
            <p class="pillar-intro">
              No fixed packages. Here's why: every site is different. So we audit yours first, then
              build a plan around your product, your competition and your goals, priced to pay for
              itself.
            </p>
            <div class="hero-actions">
              <a href="/contact" class="button">Book a free SEO session</a>
              <a href={whatsappUrl("Hi SERP Mentor, I'd like to book a free SEO session.")} class="button-secondary" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
              </a>
              <a href="#packages" class="button-ghost">See the tracks</a>
            </div>
            <PageByline />
          </div>
          <HeroTrustCard />
        </div>
      </section>

      <section class="section section-alt" id="packages">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Three tracks</h2>
              <p>Pick the one that matches your site. The scope flexes from there.</p>
            </div>
          </div>
          <div class="package-grid">
            {
              packages.map((pkg) => (
                <div class="package-card" style={`--topic: ${pkg.soft}; --topic-fg: ${pkg.color};`}>
                  <span class="card-icon"><i class={pkg.icon} aria-hidden="true" /></span>
                  <h3>{pkg.name}</h3>
                  <p class="package-for">{pkg.for}</p>

                  <p class="package-label">What's included</p>
                  <ul class="check-list">
                    {pkg.includes.map((item) => <li>{item}</li>)}
                  </ul>

                  <p class="package-label">Results you can expect</p>
                  <ul class="package-results">
                    {pkg.results.map((item) => <li>{item}</li>)}
                  </ul>

                  <a href="/contact" class="button package-cta">Get started</a>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Add-on services</h2>
              <p>End-to-end support beyond the monthly work</p>
            </div>
          </div>
          <div class="feature-grid">
            {
              addOns.map((item) => (
                <div class="feature-panel">
                  <span class="card-icon"><i class={item.icon} aria-hidden="true" /></span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <SeoForecast
        heading="What a 12-month SEO plan can look like"
        intro="A projection for a mid-sized site starting from a modest base, mixed informational and commercial intent. The first two months are audit and fixes, so the curve is flat before it compounds."
        seriesLabel="Projected organic sessions per month"
        unit="sessions"
        points={[1200, 1350, 1650, 2200, 2800, 3600, 4500, 5400, 6200, 7000, 7700, 8300]}
        convRate={0.026}
        convLabel="Enquiries"
        timing="First ranking movement typically 6–10 weeks in; the compounding phase runs from month four."
        assumptions={[
          "Starting point ~1,200 organic sessions per month with some existing authority",
          "3–5 new or rebuilt pages per month, plus on-page fixes across the site",
          "Manual link building at a steady, modest pace",
          "A 2.6% site-wide enquiry conversion rate (form + call), unchanged over the year",
        ]}
      />

      <Faq items={faqs} />

      <section class="section section-alt">
        <div class="container">
          <div class="split-layout">
            <div class="story-copy">
              <h2>Talk to a person first</h2>
              <p>
                Book a free consulting call. We'll look at your site together, talk through your
                goals, and tell you honestly whether we're the right fit.
              </p>
              <p>
                Prefer to message? WhatsApp or call{" "}
                <a href={`tel:${CONTACT.tel}`}>{CONTACT.phoneDisplay}</a>, or email{" "}
                <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
              </p>
              <div class="hero-actions">
                <a href="/contact" class="button">Schedule a call</a>
                <a href={whatsappUrl("Hi SERP Mentor, I'd like to schedule a call about SEO.")} class="button-secondary" target="_blank" rel="noopener noreferrer">
                  <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
                </a>
              </div>
            </div>
            <div class="office-list">
              {
                OFFICES.map((office) => (
                  <div class="office-card">
                    <i class="fa-solid fa-building" aria-hidden="true" />
                    <div>
                      <strong>{office.country}</strong>
                      <span>{office.address}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
