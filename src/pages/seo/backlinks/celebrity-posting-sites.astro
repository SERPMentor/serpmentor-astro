      </div>

      <section class="section section-alt">
        <div class="container">
          <div class="cta-panel" style="text-align: center; max-width: 720px; margin: 0 auto;">
            <h2>Want us to run the outreach?</h2>
            <p>
              We shortlist the entertainment outlets that carry weight, shape the angle or data with your team,
              write the pitches and place them on real publications. No link farms, no gossip aggregators, no risk.
            </p>
            <div class="hero-actions" style="justify-content: center; margin-top: 0;">
              <a href="/services" class="button">View services</a>
              <a
                href={whatsappUrl("Hi SERP Mentor, I would like help with entertainment and celebrity guest posting and digital PR.")}
                class="button-secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
