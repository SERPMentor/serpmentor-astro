    <meta name="twitter:image" content={abs("/images/posting/uk-posting-sites.png")} />
    <JsonLd graph={graph} />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section
        class="page-header pillar-hero"
        style="--topic: rgba(241,94,74,0.16); --topic-fg: #d8412c;"
      >
