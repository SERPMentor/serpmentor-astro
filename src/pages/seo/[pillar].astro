---
// SEO pillar pages: /seo/tech, /seo/backlinks, /seo/news, /seo/tools,
// /seo/ai-optimization. Long-form topic hubs, Backlinko-hub style.
import "../../styles/global.css";
import Favicons from "../../components/Favicons.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostCard from "../../components/PostCard.astro";
import { getPillars, getPillar, pillarPath } from "../../lib/pillars";
import { guideBySlug, guidePath } from "../../lib/seo-guides";
import {
  getAllPosts,
  getPostsInCategory,
  categoryPath,
  postPath,
  primaryCategory,
  isBacklinksCategory,
  type WPPost,
} from "../../lib/posts";
import JsonLd from "../../components/JsonLd.astro";
import {
  abs,
  webPageNode,
  breadcrumbNode,
  itemListNode,
} from "../../lib/schema";

export async function getStaticPaths() {
  return getPillars("seo").map((pillar) => ({
    params: { pillar: pillar.slug },
    props: { pillarSlug: pillar.slug },
  }));
}

const { pillar: pillarSlug } = Astro.params;
const pillar = getPillar("seo", pillarSlug!)!;

const allPosts = await getAllPosts();
const bySlug = new Map(allPosts.map((p) => [p.slug, p]));

let guides: WPPost[];

if (pillar.slug === "backlinks") {
  // The backlinks pillar is the archive for every link-building post
  // (/seo/backlinks/{slug}), so list them all, newest first.
  guides = allPosts.filter((p) => isBacklinksCategory(primaryCategory(p).slug));
  // hand-built link-building posts that don't come from WordPress
  guides.unshift(
    {
      title: "Real Estate Posting Sites: 100 Places to Publish",
      slug: "real-estate-posting-sites",
      date: "2026-09-01T09:00:00Z",
      excerpt:
        "100 live real estate sites for guest posts: residential, investing, property management, commercial and proptech, with DR, DA and traffic.",
      categories: { nodes: [{ slug: "seo-backlinks", name: "SEO Backlinks" }] },
    } as WPPost,
    {
      title: "Finance Posting Sites: 100 Places to Publish",
      slug: "finance-posting-sites",
      date: "2026-09-01T09:00:00Z",
      excerpt:
        "100 live finance, investing, personal-finance and fintech sites for guest posts, with Domain Rating, Domain Authority and traffic.",
      categories: { nodes: [{ slug: "seo-backlinks", name: "SEO Backlinks" }] },
    } as WPPost,
    {
      title: "Lifestyle Posting Sites: 100 Places to Publish",
      slug: "lifestyle-posting-sites",
      date: "2026-09-01T09:00:00Z",
      excerpt:
        "100 live lifestyle, fashion, home, food and travel sites for guest posts, with Domain Rating, Domain Authority and traffic.",
      categories: { nodes: [{ slug: "seo-backlinks", name: "SEO Backlinks" }] },
    } as WPPost,
    {
      title: "Dating Posting Sites: 100 Places to Publish Relationship Content",
      slug: "dating-posting-sites",
      date: "2026-09-01T09:00:00Z",
      excerpt:
        "100 dating and relationship sites for guest posts, with Domain Rating and Domain Authority, plus how to pitch a niche full of bad pitches.",
      categories: { nodes: [{ slug: "seo-backlinks", name: "SEO Backlinks" }] },
    } as WPPost,
    {
      title: "UK Posting Sites: 100 Places to Publish",
      slug: "uk-posting-sites",
      date: "2026-09-01T09:00:00Z",
      excerpt:
        "100 UK sites for guest posts, with Domain Rating and Domain Authority, plus how to shortlist and pitch them.",
      categories: { nodes: [{ slug: "seo-backlinks", name: "SEO Backlinks" }] },
    } as WPPost,
  );
  // fold in any hand-picked backlink guides that sit in the general SEO category
  for (const s of pillar.guideSlugs) {
    const p = bySlug.get(s);
    if (p && !guides.some((g) => g.slug === p.slug)) guides.push(p);
  }
} else {
  guides = pillar.guideSlugs
    .map((slug) => bySlug.get(slug))
    .filter((p): p is WPPost => Boolean(p));
  if (guides.length === 0) {
    guides = (await getPostsInCategory("seo")).slice(0, 6);
  }
}

const guideSet = new Set(guides.map((p) => p.slug));
const moreFromSeo = (await getPostsInCategory("seo"))
  .filter((p) => !guideSet.has(p.slug))
  .slice(0, 3);

const otherPillars = getPillars("seo").filter((p) => p.slug !== pillar.slug);

// Trending topic guides most relevant to each pillar (from src/lib/seo-guides.ts)
const PILLAR_GUIDES: Record<string, string[]> = {
  tech: ["programmatic-seo", "interaction-to-next-paint", "schema-markup", "search-intent"],
  backlinks: ["digital-pr", "reddit-seo", "topical-authority", "entity-seo"],
  news: [
    "google-core-update-recovery",
    "zero-click-search",
    "content-decay",
    "e-e-a-t",
    "ai-content-and-seo",
  ],
  tools: ["get-cited-by-chatgpt", "generative-engine-optimization", "rank-in-google-ai-overviews"],
  "ai-optimization": [
    "rank-in-google-ai-overviews",
    "answer-engine-optimization",
    "generative-engine-optimization",
    "get-cited-by-chatgpt",
    "llms-txt",
    "ai-content-and-seo",
    "entity-seo",
    "semantic-seo",
  ],
};
const pillarGuides = (PILLAR_GUIDES[pillar.slug] ?? [])
  .map((s) => guideBySlug(s))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

// Build the in-page table of contents from the body <h2>s and inject
// matching ids so the anchor links land in the right place.
function slugify(text: string): string {
  return (
    text
      .toLowerCase()
      .replace(/<[^>]+>/g, "")
      .replace(/[^a-z0-9\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-") || "section"
  );
}

const bodyToc: { text: string; id: string }[] = [];
let h2Count = 0;
const bodyHtml = pillar.bodyHtml.replace(
  /<h2([^>]*)>([\s\S]*?)<\/h2>/gi,
  (_m: string, attrs: string, inner: string) => {
    h2Count += 1;
    const text = inner.replace(/<[^>]+>/g, "").trim();
    const id = `${slugify(text)}-${h2Count}`;
    bodyToc.push({ text, id });
    return `<h2${attrs} id="${id}">${inner}</h2>`;
  },
);

const toc = [
  ...bodyToc,
  { text: pillar.guidesHeading, id: "guides" },
  ...(pillarGuides.length ? [{ text: "Trending topics", id: "trending" }] : []),
  ...(pillar.tools ? [{ text: pillar.toolsHeading!, id: "tools" }] : []),
  ...(moreFromSeo.length ? [{ text: "More SEO guides", id: "more" }] : []),
];

const pageUrl = abs(pillarPath(pillar));
const graph = [
  webPageNode({
    url: pageUrl,
    name: `${pillar.title} | SERP Mentor`,
    description: pillar.intro,
    type: "CollectionPage",
  }),
  breadcrumbNode(pageUrl, [
    { name: "Home", item: abs("/") },
    { name: "SEO", item: abs(categoryPath("seo")) },
    { name: pillar.name },
  ]),
  itemListNode(
    pageUrl,
    guides.map((p) => ({ url: abs(postPath(p)), name: p.title })),
    pillar.guidesHeading,
  ),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>{pillar.title} | SERP Mentor</title>
    <meta name="description" content={pillar.intro} />
    <link rel="canonical" href={pillarPath(pillar)} />
    <JsonLd graph={graph} />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section
        class="page-header pillar-hero"
        style={`--topic: ${pillar.colorSoft}; --topic-fg: ${pillar.color};`}
      >
        <div class="container">
          <div class="breadcrumbs">
            <a href="/">Home</a>
            <span>›</span>
            <a href={categoryPath("seo")}>SEO</a>
            <span>›</span>
            <span>{pillar.name}</span>
          </div>

          <span class="card-icon pillar-icon"><i class={pillar.icon} aria-hidden="true" /></span>
          <p class="eyebrow">{pillar.eyebrow}</p>
          <h1>{pillar.title}</h1>
          <p class="pillar-intro">{pillar.intro}</p>
        </div>
      </section>

      <section class="content-body">
        <div class="container article-shell">
          <div class="prose pillar-body" set:html={bodyHtml} />

          <aside class="article-toc">
            <h4>On this page</h4>
            <ul>
              {toc.map((item) => (
                <li><a href={`#${item.id}`}>{item.text}</a></li>
              ))}
            </ul>
          </aside>
        </div>
      </section>

      <section class="section section-alt" id="guides">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>{pillar.guidesHeading}</h2>
              <p>Hand-picked, kept current</p>
            </div>
            <a href={categoryPath("seo")}>All SEO articles →</a>
          </div>

          <div class="post-grid">
            {guides.map((post) => <PostCard post={post} />)}
          </div>
        </div>
      </section>

      {
        pillarGuides.length > 0 && (
          <section class="section" id="trending">
            <div class="container">
              <div class="section-heading">
                <div>
                  <h2>Trending {pillar.name} topics</h2>
                  <p>Short, practical guides on what is changing right now</p>
                </div>
                <a href="/seo/guides">All trending topics →</a>
              </div>

              <div class="feature-grid">
                {pillarGuides.map((g) => (
                  <a
                    href={guidePath(g)}
                    class="feature-panel card-link"
                    style={`--topic: ${pillar.colorSoft}; --topic-fg: ${pillar.color};`}
                  >
                    <span class="card-icon"><i class={g.icon} aria-hidden="true" /></span>
                    <h3>{g.title}</h3>
                    <p>{g.intro}</p>
                    <span class="card-cta">Read guide →</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        pillar.tools && (
          <section class="section" id="tools">
            <div class="container">
              <div class="section-heading">
                <div>
                  <h2>{pillar.toolsHeading}</h2>
                  <p>Run a check in seconds, no signup</p>
                </div>
                <a href="/resources" class="button-secondary">
                  View all tools
                </a>
              </div>

              <div class="feature-grid">
                {pillar.tools.map((tool) => (
                  <a href={tool.href} class="feature-panel card-link card-center">
                    <span
                      class="card-icon"
                      style={`--topic: ${pillar.colorSoft}; --topic-fg: ${pillar.color};`}
                    >
                      <i class={tool.icon} aria-hidden="true" />
                    </span>
                    <h3>{tool.title}</h3>
                    <p>{tool.description}</p>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        moreFromSeo.length > 0 && (
          <section class="section section-alt" id="more">
            <div class="container">
              <div class="section-heading">
                <div>
                  <h2>More SEO guides</h2>
                  <p>Fresh from the blog</p>
                </div>
                <a href="/blog" class="button-secondary">
                  View blog
                </a>
              </div>
              <div class="post-grid">
                {moreFromSeo.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Other SEO pillars</h2>
              <p>Work through the whole topic</p>
            </div>
          </div>
          <div class="feature-grid">
            {
              otherPillars.map((other) => (
                <a
                  href={pillarPath(other)}
                  class="feature-panel card-link"
                  style={`--topic: ${other.colorSoft}; --topic-fg: ${other.color};`}
                >
                  <span class="card-icon">
                    <i class={other.icon} aria-hidden="true" />
                  </span>
                  <h3>{other.name}</h3>
                  <p>{other.cardText}</p>
                  <span class="card-cta">Open pillar →</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="cta-panel" style="text-align: center; max-width: 720px; margin: 0 auto;">
            <h2>Want this done for your site?</h2>
            <p>
              We turn these frameworks into an execution plan: technical fixes, content
              roadmap, and AI-search visibility, prioritized by business impact.
            </p>
            <div class="hero-actions" style="justify-content: center; margin-top: 0;">
              <a href="/services" class="button">View services</a>
              <a href="/contact" class="button-secondary">Schedule a call</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
