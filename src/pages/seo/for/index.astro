---
import "../../../styles/global.css";
import Favicons from "../../../components/Favicons.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import TrustStrip from "../../../components/TrustStrip.astro";
import JsonLd from "../../../components/JsonLd.astro";
import { whatsappUrl } from "../../../lib/site";
import { NICHES, nichesGrouped } from "../../../lib/niches";
import { abs, webPageNode, breadcrumbNode, itemListNode } from "../../../lib/schema";

const groups = nichesGrouped();
const pageUrl = abs("/seo/for");
const description =
  "SEO built around your industry. Pick your trade, practice or site type and see exactly how we get it ranking in Google and AI search.";

const graph = [
  webPageNode({ url: pageUrl, name: "SEO by Industry | SERP Mentor", description, type: "CollectionPage" }),
  breadcrumbNode(pageUrl, [
    { name: "Home", item: abs("/") },
    { name: "SEO", item: abs("/seo") },
    { name: "By industry" },
  ]),
  itemListNode(
    pageUrl,
    NICHES.map((n) => ({ url: abs(`/seo/for/${n.slug}`), name: `SEO for ${n.label}` })),
    "SEO by industry",
  ),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>SEO by Industry: Trades, Practices &amp; Content Sites | SERP Mentor</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="/seo/for" />
    <meta property="og:title" content="SEO by Industry | SERP Mentor" />
    <meta property="og:description" content={description} />
    <JsonLd graph={graph} />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="page-header" style="--topic: rgba(0,188,152,0.14); --topic-fg: #00a988;">
        <div class="container">
          <div class="breadcrumbs">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/seo">SEO</a>
            <span>›</span>
            <span>By industry</span>
          </div>
          <span class="card-icon pillar-icon"><i class="fa-solid fa-magnifying-glass-chart" aria-hidden="true"></i></span>
          <p class="eyebrow">SEO by industry</p>
          <h1>SEO built around your industry</h1>
          <p class="pillar-intro">
            The searches, the competition and the pages that rank are different for a plumber than
            for a SaaS company. Pick yours and see exactly how we approach it.
          </p>
          <div class="hero-actions">
            <a href="/contact" class="button">Get a free audit</a>
            <a href={whatsappUrl("Hi SERP Mentor, I'd like help with SEO for my industry.")} class="button-secondary" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
            </a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Why industry matters for SEO</h2>
            </div>
          </div>
          <div class="split-layout">
            <div class="story-copy">
              <p>
                A plumber ranks by owning the map pack and the "near me" searches. A SaaS company
                ranks with comparison pages and a content engine. A recipe site ranks on Core Web
                Vitals and schema. Same discipline, completely different playbook.
              </p>
              <p>
                Each page below starts from the real searches that industry's customers run, then
                lays out the two or three things that actually move rankings there. Pick yours.
              </p>
            </div>
            <div class="story-copy">
              <ul class="check-list">
                <li>The exact query clusters to build pages around</li>
                <li>What matters most for that industry, and what to ignore</li>
                <li>How a build or an audit works, and what it costs</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      {
        groups.map((group, i) => (
          <section class={i % 2 === 0 ? "section section-alt" : "section"}>
            <div class="container">
              <div class="section-heading">
                <div>
                  <h2>{group.title}</h2>
                </div>
              </div>
              <ul class="chip-list">
                {group.niches.map((n) => (
                  <li><a href={`/seo/for/${n.slug}`}>SEO for {n.label}</a></li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }

      <TrustStrip />

      <section class="section section-alt">
        <div class="container">
          <div class="cta-panel" style="max-width:820px; margin:0 auto; text-align:center;">
            <h2>Don't see your industry?</h2>
            <p>
              The list is a sample, not a limit. Tell us what you do and the searches that matter,
              and we'll show you the SEO opportunity.
            </p>
            <div class="hero-actions" style="justify-content:center;">
              <a href="/contact" class="button">Talk to us</a>
              <a href={whatsappUrl("Hi SERP Mentor, I'd like help with SEO for my business.")} class="button-secondary" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
