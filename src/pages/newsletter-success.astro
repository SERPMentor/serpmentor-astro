---
import "../styles/global.css";
import Favicons from "../components/Favicons.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>Thanks for subscribing | SERP Mentor</title>
    <meta name="description" content="You’re subscribed to the SERP Mentor newsletter." />
  </head>
  <body>
    <SiteHeader />

    <main class="content-body">
      <div class="container narrow">
        <div class="page-panel" style="text-align:center;">
          <p class="eyebrow">You’re in</p>
          <h1>You’re on the list.</h1>
          <p>
            Your first brief lands this Friday. Until then, dig into the guides.
          </p>
          <a href="/blog" class="button">Explore the blog</a>
        </div>
      </div>
    </main>

    <SiteFooter />
  </body>
</html>
