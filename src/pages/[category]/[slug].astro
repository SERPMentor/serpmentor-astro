---
// Single posts at /{category}/{slug} for the seo / linkedin / case-study
// categories. Link-building posts live at /seo/backlinks/{slug} instead
// (src/pages/seo/backlinks/[slug].astro). The shared layout is PostArticle.
import PostArticle from "../../components/PostArticle.astro";
import { getAllPosts, primaryCategory, isBacklinksCategory } from "../../lib/posts";
import { pillarSlugs } from "../../lib/pillars";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((post) => {
      const cat = primaryCategory(post).slug;
      if (isBacklinksCategory(cat)) return false; // handled by seo/backlinks/[slug]
      return !pillarSlugs(cat).has(post.slug);
    })
    .map((post) => ({
      params: { category: primaryCategory(post).slug, slug: post.slug },
      props: { listPost: post },
    }));
}

const { listPost } = Astro.props;
---

<PostArticle listPost={listPost} />
