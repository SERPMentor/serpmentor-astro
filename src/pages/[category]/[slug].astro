---
import "../../styles/global.css";
import Favicons from "../../components/Favicons.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostCard from "../../components/PostCard.astro";
import Byline from "../../components/Byline.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import ShareRail from "../../components/ShareRail.astro";
import Lightbox from "../../components/Lightbox.astro";
import { cleanExcerpt } from "../../lib/excerpt";
import { sanitizePostContent } from "../../lib/content";
import { localImage, localiseImages } from "../../lib/images";
import { getAuthor, type Author } from "../../lib/authors";
import { pillarSlugs } from "../../lib/pillars";
import {
  getAllPosts,
  getRelatedPosts,
  primaryCategory,
  postPath,
  categoryPath,
  formatDate,
  featuredImage,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((post) => {
      const cat = primaryCategory(post).slug;
      return !pillarSlugs(cat).has(post.slug);
    })
    .map((post) => ({
      params: { category: primaryCategory(post).slug, slug: post.slug },
      props: { listPost: post },
    }));
}

const { slug } = Astro.params;
const { listPost } = Astro.props;
const category = primaryCategory(listPost);

const query = `
  {
    post(id: "${slug}", idType: SLUG) {
      title
      date
      modified
      content
      excerpt
      author { node { name slug } }
    }
  }
`;

let post = null;

try {
  const response = await fetch("https://serpmentor.com/graphql", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query }),
  });
  post = (await response.json())?.data?.post ?? null;
} catch (error) {
  console.error("Failed to fetch post", error);
}

if (!post) {
  throw new Error(`Post not found: ${slug}`);
}

const cleanContent = sanitizePostContent(post.content ?? "");
const readTime = Math.max(
  4,
  Math.ceil(cleanContent.replace(/<[^>]*>/g, "").length / 900),
);

const author: Author = getAuthor(post.author?.node?.slug, post.author?.node?.name);
const publishedISO = new Date(post.date).toISOString();
const modifiedISO = new Date(post.modified ?? post.date).toISOString();
const updatedLabel = formatDate(post.modified ?? post.date, "short");

const heroImage = featuredImage(listPost);
const heroImageSrc = heroImage ? localImage(heroImage.sourceUrl) : null;
const shareUrl = new URL(postPath(listPost), Astro.site ?? "https://serpmentor.com").href;

const authorSlug = post.author?.node?.slug;
const authorPostCount = authorSlug
  ? (await getAllPosts()).filter((p) => p.author?.node?.slug === authorSlug).length
  : 0;

// Build the in-page TOC and inject matching ids into the content in one pass.
function slugify(text: string): string {
  return (
    text
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-") || "section"
  );
}

const headings: { level: number; text: string; id: string }[] = [];
let headingCount = 0;

const contentWithAnchors = localiseImages(cleanContent).replace(
  /<h([2-3])([^>]*)>([\s\S]*?)<\/h\1>/gi,
  (_m: string, level: string, attrs: string, inner: string) => {
    headingCount += 1;
    const text = inner.replace(/<[^>]+>/g, "").trim();
    const id = `${slugify(text)}-${headingCount}`;
    headings.push({ level: Number(level), text, id });
    return `<h${level}${attrs} id="${id}">${inner}</h${level}>`;
  },
);

const relatedPosts = await getRelatedPosts(listPost, 3);
const metaDescription = cleanExcerpt(post.excerpt, 155);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: metaDescription,
  image: heroImageSrc ?? undefined,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  author: { "@type": "Person", name: author.name, url: new URL(`/author/${author.slug}`, Astro.site ?? "https://serpmentor.com").href },
  publisher: {
    "@type": "Organization",
    name: "SERP Mentor",
    logo: { "@type": "ImageObject", url: new URL("/logo.png", Astro.site ?? "https://serpmentor.com").href },
  },
  mainEntityOfPage: shareUrl,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <Favicons />
    <title>{post.title} | SERP Mentor</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={shareUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={shareUrl} />
    {heroImageSrc && <meta property="og:image" content={heroImageSrc} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="article:published_time" content={publishedISO} />
    <meta property="article:modified_time" content={modifiedISO} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <SiteHeader />
    <div class="reading-progress"><span></span></div>

    <main>
      <section class="article-hero">
        <div class="container article-hero-grid">
          <div>
            <nav class="breadcrumbs breadcrumbs-invert" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span>›</span>
              <a href={categoryPath(category.slug)}>{category.name}</a>
            </nav>

            <a href={categoryPath(category.slug)} class="article-hero-tag">{category.name}</a>
            <h1>{post.title}</h1>
            <Byline author={author} updated={updatedLabel} readTime={readTime} invert />
          </div>

          {
            heroImage && (
              <div class="article-hero-media js-zoom">
                <img
                  src={heroImageSrc}
                  alt={heroImage.altText || post.title}
                  width="1280"
                  height="720"
                  fetchpriority="high"
                />
              </div>
            )
          }
        </div>
      </section>

      <section class="content-body">
        <div class="container article-layout">
          <ShareRail url={shareUrl} title={post.title} />

          <article class="post-content prose">
            <div class="js-zoom" set:html={contentWithAnchors} />

            <div class="cta-panel">
              <h3>Need help putting this into practice?</h3>
              <p>
                We turn the frameworks in these guides into a prioritized execution plan —
                technical fixes, content roadmap, and AI-search visibility.
              </p>
              <a href="/contact" class="button">Book a strategy call</a>
            </div>
          </article>

          {
            headings.length > 0 && (
              <aside class="article-toc" aria-label="On this page">
                <h4>On this page</h4>
                <ul>
                  {headings.map((heading) => (
                    <li
                      class:list={[{ "toc-sub": heading.level === 3 }]}
                      data-toc-id={heading.id}
                    >
                      <a href={`#${heading.id}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <AuthorCard author={author} postCount={authorPostCount} />
        </div>
      </section>

      {
        relatedPosts.length > 0 && (
          <section class="section">
            <div class="container">
              <div class="section-heading">
                <div>
                  <h2>Continue reading</h2>
                  <p>More from {category.name}</p>
                </div>
                <a href={categoryPath(category.slug)}>All {category.name} articles →</a>
              </div>
              <div class="post-grid">
                {relatedPosts.map((item) => (
                  <PostCard post={item} dateStyle="short" cta="Read more →" />
                ))}
              </div>
            </div>
          </section>
        )
      }
    </main>

    <SiteFooter />

    <Lightbox />

    <button class="back-to-top" type="button" aria-label="Back to top" hidden>
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script>
      // Reading-progress bar
      const bar = document.querySelector<HTMLElement>(".reading-progress span");
      const article = document.querySelector<HTMLElement>(".post-content");
      const toTop = document.querySelector<HTMLButtonElement>(".back-to-top");
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".article-toc a"),
      );

      function onScroll() {
        if (bar && article) {
          const start = article.offsetTop - 120;
          const end = start + article.offsetHeight - window.innerHeight + 120;
          const pct = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
          bar.style.width = `${pct * 100}%`;
        }
        if (toTop) toTop.hidden = window.scrollY < 600;
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      toTop?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" }),
      );

      // Highlight the current section in the TOC
      if (tocLinks.length) {
        const byId = new Map(
          tocLinks.map((a) => [a.getAttribute("href")!.slice(1), a]),
        );
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                tocLinks.forEach((a) => a.classList.remove("is-active"));
                byId.get(entry.target.id)?.classList.add("is-active");
              }
            });
          },
          { rootMargin: "-90px 0px -70% 0px" },
        );
        document
          .querySelectorAll(".post-content h2, .post-content h3")
          .forEach((h) => observer.observe(h));
      }
    </script>
  </body>
</html>
