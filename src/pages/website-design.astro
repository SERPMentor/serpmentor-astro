---
import "../styles/global.css";
import Favicons from "../components/Favicons.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Faq from "../components/Faq.astro";
import SeoForecast from "../components/SeoForecast.astro";
import JsonLd from "../components/JsonLd.astro";
import HeroTrustCard from "../components/HeroTrustCard.astro";
import PageByline from "../components/PageByline.astro";
import { whatsappUrl } from "../lib/site";
import { BUILD_GROUPS, BUILD_MARKETS } from "../lib/build-services";
import { nichesGrouped } from "../lib/niches";

// pair each niche group with the matching blurb + icon from BUILD_GROUPS (same order)
const nicheGroups = nichesGrouped().map((g, i) => ({
  ...g,
  icon: BUILD_GROUPS[i]?.icon ?? "fa-solid fa-store",
  blurb: BUILD_GROUPS[i]?.blurb ?? "",
}));
import { abs, webPageNode, breadcrumbNode, serviceNode, bylinePersonNodes, BYLINE_REFS } from "../lib/schema";

const pgUrl = abs("/website-design");
const pgDesc =
  "We build websites for any business: plumbers, electricians, HVAC, clinics, law firms, e-commerce, SaaS, and content sites in games, tech and finance. SEO-first, fast, and optimised for the US, Canada, Australia and beyond.";
const pgGraph = [
  { ...webPageNode({ url: pgUrl, name: "Website Design & Development | SERP Mentor", description: pgDesc }), ...BYLINE_REFS },
  ...bylinePersonNodes(),
  breadcrumbNode(pgUrl, [{ name: "Home", item: abs("/") }, { name: "Website design" }]),
  serviceNode({
    url: pgUrl,
    name: "Website design & development",
    description: pgDesc,
    serviceType: "Website design and development",
  }),
];

const wa = whatsappUrl("Hi SERP Mentor, I'd like a quote to build a website.");

const includes = [
  {
    icon: "fa-solid fa-sitemap",
    title: "SEO-first architecture",
    text: "URL structure, internal linking, schema and metadata planned before design, so the site can rank, not just look good.",
  },
  {
    icon: "fa-solid fa-gauge-high",
    title: "Fast by default",
    text: "Green Core Web Vitals out of the box: optimised images, minimal scripts, and a build that stays quick as it grows.",
  },
  {
    icon: "fa-solid fa-mobile-screen",
    title: "Mobile & conversion design",
    text: "Designed for the phone first, with clear calls to action, quote forms and click-to-call that turn visits into enquiries.",
  },
  {
    icon: "fa-solid fa-pen-to-square",
    title: "Easy to run yourself",
    text: "A clean CMS your team can edit without breaking anything, plus a short handover so you're not dependent on us.",
  },
];

const steps = [
  {
    icon: "fa-solid fa-compass",
    title: "Discovery",
    text: "We look at your market, competitors and the searches that matter, then agree the pages and keywords the site is built around.",
  },
  {
    icon: "fa-solid fa-pen-ruler",
    title: "Design",
    text: "Wireframes then visual design for the key templates (home, service, location and article pages), approved before we build.",
  },
  {
    icon: "fa-solid fa-code",
    title: "Build",
    text: "Development on WordPress, a headless/Astro stack or Shopify, with SEO, schema and analytics wired in as we go.",
  },
  {
    icon: "fa-solid fa-rocket",
    title: "Launch",
    text: "Redirects mapped, Search Console and analytics verified, speed checked. A launch that keeps the rankings you have.",
  },
  {
    icon: "fa-solid fa-arrow-trend-up",
    title: "Grow",
    text: "Optional ongoing SEO and content so the site keeps gaining traffic after it goes live, not just at launch.",
  },
];

const platforms = [
  { icon: "fa-brands fa-wordpress", name: "WordPress" },
  { icon: "fa-solid fa-bolt", name: "Astro / headless" },
  { icon: "fa-brands fa-shopify", name: "Shopify" },
  { icon: "fa-brands fa-react", name: "Next.js" },
  { icon: "fa-brands fa-webflow", name: "Webflow" },
];

const faqs = [
  {
    q: "Can you really build any type of website?",
    a: "Within reason, yes: local service sites, professional and medical practices, content and affiliate sites, online stores, SaaS marketing sites and startup landing pages. If it needs a heavy custom web app we'll tell you and point you to the right people.",
  },
  {
    q: "How long does a build take?",
    a: "A focused small-business or local-service site is usually 3–5 weeks. A larger content site or store with many templates is 6–10 weeks. We give you a firm timeline after discovery.",
  },
  {
    q: "How much does it cost?",
    a: "It depends on the number of templates, pages and integrations. Send us the brief and we quote a fixed project price, with no hourly surprises.",
  },
  {
    q: "Do you write the content too?",
    a: "We can. Many clients bring their own copy for core pages and have us write the SEO-driven service and location pages, plus ongoing articles.",
  },
  {
    q: "We already have a site. Can you rebuild or migrate it?",
    a: "Yes. Migrations are handled carefully: full redirect mapping, a staging site, and post-launch monitoring so you don't lose the rankings and traffic you already have.",
  },
  {
    q: "Do you set up local SEO for our country and city?",
    a: "Yes: Google Business Profile, local schema, citations, and city/service landing pages set up for your market, whether that's the US, Canada, Australia, the UK or elsewhere.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>Website Design & Development: Built to Rank and Convert | SERP Mentor</title>
    <meta
      name="description"
      content="We build websites for any business: plumbers, electricians, HVAC, clinics, law firms, e-commerce, SaaS, and content sites in games, tech and finance. SEO-first, fast, and optimised for the US, Canada, Australia and beyond."
    />
    <link rel="canonical" href="/website-design" />
    <meta property="og:title" content="Website Design & Development | SERP Mentor" />
    <JsonLd graph={pgGraph} />
    <meta property="og:description" content="Any website, built SEO-first. Fast, mobile, and made to convert." />
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="page-header page-header-split" style="--topic: rgba(130,86,197,0.16); --topic-fg: #8256c5;">
        <div class="container">
          <div>
            <div class="breadcrumbs">
              <a href="/">Home</a>
              <span>›</span>
              <span>Website design</span>
            </div>
            <span class="card-icon pillar-icon"><i class="fa-solid fa-laptop-code" aria-hidden="true"></i></span>
            <p class="eyebrow">Work with us</p>
            <h1>We build websites made to rank and convert</h1>
            <p class="pillar-intro">
              Most agency websites look great and rank nowhere. Ours are built SEO-first from the
              first line of code. Fast on mobile, and designed so the phone actually rings. Any
              business, any market: local service sites, e-commerce, content sites in games, tech
              and finance.
            </p>
            <div class="hero-actions">
              <a href="/contact" class="button">Get a free quote</a>
              <a href={wa} class="button-secondary" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
              </a>
              <a href="#industries" class="button-ghost">See what we build</a>
            </div>
            <PageByline />
          </div>
          <HeroTrustCard />
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>What every build includes</h2>
              <p>The difference between a website and a website that grows</p>
            </div>
          </div>
          <div class="feature-grid feature-grid-4">
            {
              includes.map((item) => (
                <div class="feature-panel">
                  <span class="card-icon"><i class={item.icon} aria-hidden="true" /></span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-alt" id="industries">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Websites we build</h2>
              <p>A few of the businesses we've built for. Yours doesn't have to be on the list.</p>
            </div>
          </div>
          <div class="build-groups">
            {
              nicheGroups.map((group) => (
                <div class="feature-panel build-group">
                  <span class="card-icon"><i class={group.icon} aria-hidden="true" /></span>
                  <h3>{group.title}</h3>
                  <p>{group.blurb}</p>
                  <ul class="chip-list">
                    {group.niches.map((n) => (
                      <li><a href={`/seo/for/${n.slug}`}>{n.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <p class="build-groups-note">
            Each links to how we approach SEO for that industry. <a href="/seo/for">See all industries →</a>
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Built for your market</h2>
              <p>
                Local SEO set up for the country and city you serve: Google Business Profile,
                local schema, citations and city/service pages, in the right language and currency.
              </p>
            </div>
          </div>
          <ul class="market-list">
            {
              BUILD_MARKETS.map((m) => (
                <li>
                  <span class="market-flag" aria-hidden="true">{m.flag}</span>
                  {m.name}
                </li>
              ))
            }
            <li class="market-more">…and anywhere your customers search</li>
          </ul>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>How a build works</h2>
              <p>Five stages, one fixed quote</p>
            </div>
            <a href="/services">See all services →</a>
          </div>
          <div class="feature-grid feature-grid-5">
            {
              steps.map((step, i) => (
                <div class="feature-panel">
                  <span class="step-number">{String(i + 1).padStart(2, "0")}</span>
                  <h3><i class={step.icon} aria-hidden="true" /> {step.title}</h3>
                  <p>{step.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <h2>Platforms we build on</h2>
              <p>We pick the one that fits your team and your goals, not the one we sell</p>
            </div>
          </div>
          <ul class="platform-list">
            {
              platforms.map((p) => (
                <li>
                  <i class={p.icon} aria-hidden="true" />
                  {p.name}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <SeoForecast
        heading="What a brand-new site can do in its first year"
        intro="A new domain starts at zero and spends its first weeks being indexed and earning trust, so the first two months look quiet on purpose. This projects a small business site that launches with 20 to 30 well-structured pages and keeps publishing."
        seriesLabel="Projected organic sessions per month"
        unit="sessions"
        points={[40, 90, 260, 620, 1100, 1700, 2400, 3100, 3800, 4400, 4900, 5200]}
        convRate={0.034}
        convLabel="Enquiries"
        timing="A new domain is usually fully indexed in 2 to 4 weeks; the first real rankings tend to land 8 to 12 weeks after launch as the site earns trust."
        assumptions={[
          "A new domain with no history, launching with 20 to 30 pages built SEO-first",
          "Four to six new service, location or article pages published per month",
          "A modest, steady link-building effort from month two",
          "A 3.4% enquiry conversion rate, because the layout and calls to action are designed in from the start",
        ]}
      />

      <Faq items={faqs} />

      <section class="section section-alt">
        <div class="container">
          <div class="cta-panel" style="max-width:820px; margin:0 auto; text-align:center;">
            <h2>Tell us what you need built</h2>
            <p>
              Send a short brief: your business, your market, and roughly what pages you need.
              We'll come back with a fixed quote and a timeline.
            </p>
            <div class="hero-actions" style="justify-content:center;">
              <a href="/contact" class="button">Get a free quote</a>
              <a href={wa} class="button-secondary" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
