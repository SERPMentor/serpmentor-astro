---
/**
 * The full single-post article layout (Backlinko-style): coloured hero, byline,
 * 3-column body with share rail + scroll-spy TOC, author card and "continue
 * reading" grid, plus Article / WebPage / BreadcrumbList JSON-LD.
 *
 * Used by both `src/pages/[category]/[slug].astro` (seo / linkedin / case-study
 * posts) and `src/pages/seo/backlinks/[slug].astro` (link-building posts, which
 * nest under the backlinks pillar). The only difference between the two routes
 * is which posts each `getStaticPaths` emits; the rendering lives here.
 */
import "../styles/global.css";
import Favicons from "./Favicons.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import PostCard from "./PostCard.astro";
import Byline from "./Byline.astro";
import AuthorCard from "./AuthorCard.astro";
import ShareRail from "./ShareRail.astro";
import Lightbox from "./Lightbox.astro";
import Faq from "./Faq.astro";
import { cleanExcerpt, decodeEntities } from "../lib/excerpt";
import { sanitizePostContent } from "../lib/content";
import { localImage, localiseImages } from "../lib/images";
import { getAuthor, type Author } from "../lib/authors";
import { whatsappUrl } from "../lib/site";
import { BLOG_CONTENT } from "../lib/blog-content";
import JsonLd from "./JsonLd.astro";
import {
  abs,
  webPageNode,
  breadcrumbNode,
  articleNode,
  personNode,
} from "../lib/schema";
import {
  WP_URL,
  getAllPosts,
  getRelatedPosts,
  primaryCategory,
  postPath,
  categoryPath,
  formatDate,
  featuredImage,
  type WPPost,
} from "../lib/posts";

interface Props {
  listPost: WPPost;
}

const { listPost } = Astro.props;
const slug = listPost.slug;
const category = primaryCategory(listPost);

// A hand-authored rewrite in src/lib/blog-content.ts takes over the body (and,
// where set, the title / meta / date). If none exists, fall back to the live
// WordPress post body.
const rewrite = BLOG_CONTENT[slug];

let bodyRaw = "";
let title = listPost.title;
let publishedISO = new Date(listPost.date).toISOString();
let modifiedISO = publishedISO;
let updatedLabel = formatDate(listPost.date, "short");
let rawExcerpt = listPost.excerpt ?? "";
let authorNodeSlug = listPost.author?.node?.slug;
let authorNodeName = listPost.author?.node?.name;

if (rewrite) {
  bodyRaw = rewrite.bodyHtml;
  if (rewrite.title) title = rewrite.title;
  if (rewrite.excerpt) rawExcerpt = rewrite.excerpt;
  const mod = rewrite.updated ? new Date(rewrite.updated) : new Date();
  if (!Number.isNaN(mod.valueOf())) {
    modifiedISO = mod.toISOString();
    updatedLabel = formatDate(mod.toISOString(), "short");
  }
} else {
  const query = `
    {
      post(id: "${slug}", idType: SLUG) {
        title
        date
        modified
        content
        excerpt
        author { node { name slug } }
      }
    }
  `;
  let post = null;
  try {
    const response = await fetch(`${WP_URL}/graphql`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ query }),
    });
    post = (await response.json())?.data?.post ?? null;
  } catch (error) {
    console.error("Failed to fetch post", error);
  }
  if (!post) {
    throw new Error(`Post not found: ${slug}`);
  }
  bodyRaw = sanitizePostContent(post.content ?? "");
  title = title;
  rawExcerpt = post.excerpt ?? "";
  publishedISO = new Date(post.date).toISOString();
  modifiedISO = new Date(post.modified ?? post.date).toISOString();
  updatedLabel = formatDate(post.modified ?? post.date, "short");
  authorNodeSlug = post.author?.node?.slug;
  authorNodeName = post.author?.node?.name;
}

const readTime = Math.max(
  4,
  Math.ceil(bodyRaw.replace(/<[^>]*>/g, "").length / 900),
);

const author: Author = getAuthor(authorNodeSlug, authorNodeName);

const heroImage = featuredImage(listPost);
const heroImageSrc = heroImage ? localImage(heroImage.sourceUrl) : null;
const shareUrl = new URL(postPath(listPost), Astro.site ?? "https://serpmentor.com").href;

const authorPostCount = authorNodeSlug
  ? (await getAllPosts()).filter((p) => p.author?.node?.slug === authorNodeSlug).length
  : 0;

// Build the in-page TOC and inject matching ids into the content in one pass.
function slugify(text: string): string {
  return (
    text
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-") || "section"
  );
}

const headings: { level: number; text: string; id: string }[] = [];
let headingCount = 0;

const contentWithAnchors = localiseImages(bodyRaw).replace(
  /<h([2-3])([^>]*)>([\s\S]*?)<\/h\1>/gi,
  (_m: string, level: string, attrs: string, inner: string) => {
    headingCount += 1;
    const text = decodeEntities(inner.replace(/<[^>]+>/g, ""))
      .replace(/\s*—\s*/g, ", ")
      .trim();
    const id = `${slugify(text)}-${headingCount}`;
    headings.push({ level: Number(level), text, id });
    return `<h${level}${attrs} id="${id}">${inner}</h${level}>`;
  },
);

const relatedPosts = await getRelatedPosts(listPost, 3);
const metaDescription =
  rewrite?.metaDescription?.trim() || cleanExcerpt(rawExcerpt, 155);
const pageTitle = rewrite?.metaTitle?.trim() || `${title} | SERP Mentor`;

const authorUrl = abs(`/author/${author.slug}`);
const heroAbs = heroImageSrc ? abs(heroImageSrc) : undefined;
const authorSameAs = Object.entries(author.socials ?? {})
  .filter(([k, v]) => v && k !== "email" && String(v).startsWith("http"))
  .map(([, v]) => String(v));

const graph = [
  webPageNode({
    url: shareUrl,
    name: title,
    description: metaDescription,
    type: "WebPage",
    image: heroAbs,
    datePublished: publishedISO,
    dateModified: modifiedISO,
  }),
  breadcrumbNode(shareUrl, [
    { name: "Home", item: abs("/") },
    { name: category.name, item: abs(categoryPath(category.slug)) },
    { name: title },
  ]),
  articleNode({
    url: shareUrl,
    headline: title,
    description: metaDescription,
    image: heroAbs,
    datePublished: publishedISO,
    dateModified: modifiedISO,
    authorName: author.name,
    authorUrl,
    section: category.name,
  }),
  personNode({
    url: authorUrl,
    name: author.name,
    jobTitle: author.title,
    description: author.bio,
    image: author.image ? abs(localImage(author.image)) : undefined,
    sameAs: authorSameAs,
  }),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicons />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={shareUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={shareUrl} />
    {heroImageSrc && <meta property="og:image" content={heroImageSrc} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="article:published_time" content={publishedISO} />
    <meta property="article:modified_time" content={modifiedISO} />
    <JsonLd graph={graph} />
  </head>
  <body>
    <SiteHeader />
    <div class="reading-progress"><span></span></div>

    <main>
      <section class="article-hero">
        <div class="container article-hero-grid">
          <div>
            <nav class="breadcrumbs breadcrumbs-invert" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span>›</span>
              <a href={categoryPath(category.slug)}>{category.name}</a>
            </nav>

            <a href={categoryPath(category.slug)} class="article-hero-tag">{category.name}</a>
            <h1>{title}</h1>
            <Byline author={author} updated={updatedLabel} readTime={readTime} invert />
          </div>

          {
            heroImage && (
              <div class="article-hero-media js-zoom">
                <img
                  src={heroImageSrc}
                  alt={heroImage.altText || title}
                  width="1280"
                  height="720"
                  fetchpriority="high"
                />
              </div>
            )
          }
        </div>
      </section>

      <section class="content-body">
        <div class="container article-layout">
          <ShareRail url={shareUrl} title={title} />

          <article class="post-content prose">
            <div class="js-zoom" set:html={contentWithAnchors} />

            <div class="cta-panel">
              <h3>Need help putting this into practice?</h3>
              <p>
                We turn the frameworks in these guides into a prioritized execution plan:
                technical fixes, content roadmap, and AI-search visibility.
              </p>
              <div class="hero-actions">
                <a href="/contact" class="button">Book a strategy call</a>
                <a href={whatsappUrl("Hi SERP Mentor, I read one of your guides and want help applying it.")} class="button-secondary" target="_blank" rel="noopener noreferrer">
                  <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
                </a>
              </div>
            </div>
          </article>

          {
            headings.length > 0 && (
              <aside class="article-toc" aria-label="On this page">
                <h4>On this page</h4>
                <ul>
                  {headings.map((heading) => (
                    <li
                      class:list={[{ "toc-sub": heading.level === 3 }]}
                      data-toc-id={heading.id}
                    >
                      <a href={`#${heading.id}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>
      </section>

      {rewrite?.faqs && rewrite.faqs.length > 0 && <Faq items={rewrite.faqs} />}

      <section class="section section-alt">
        <div class="container">
          <AuthorCard author={author} postCount={authorPostCount} />
        </div>
      </section>

      {
        relatedPosts.length > 0 && (
          <section class="section">
            <div class="container">
              <div class="section-heading">
                <div>
                  <h2>Continue reading</h2>
                  <p>More from {category.name}</p>
                </div>
                <a href={categoryPath(category.slug)}>All {category.name} articles →</a>
              </div>
              <div class="post-grid">
                {relatedPosts.map((item) => (
                  <PostCard post={item} dateStyle="short" cta="Read more →" />
                ))}
              </div>
            </div>
          </section>
        )
      }
    </main>

    <SiteFooter />

    <Lightbox />

    <button class="back-to-top" type="button" aria-label="Back to top" hidden>
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script>
      // Reading-progress bar
      const bar = document.querySelector<HTMLElement>(".reading-progress span");
      const article = document.querySelector<HTMLElement>(".post-content");
      const toTop = document.querySelector<HTMLButtonElement>(".back-to-top");
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".article-toc a"),
      );

      function onScroll() {
        if (bar && article) {
          const start = article.offsetTop - 120;
          const end = start + article.offsetHeight - window.innerHeight + 120;
          const pct = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
          bar.style.width = `${pct * 100}%`;
        }
        if (toTop) toTop.hidden = window.scrollY < 600;
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      toTop?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" }),
      );

      // Highlight the current section in the TOC
      if (tocLinks.length) {
        const byId = new Map(
          tocLinks.map((a) => [a.getAttribute("href")!.slice(1), a]),
        );
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                tocLinks.forEach((a) => a.classList.remove("is-active"));
                byId.get(entry.target.id)?.classList.add("is-active");
              }
            });
          },
          { rootMargin: "-90px 0px -70% 0px" },
        );
        document
          .querySelectorAll(".post-content h2, .post-content h3")
          .forEach((h) => observer.observe(h));
      }
    </script>
  </body>
</html>
