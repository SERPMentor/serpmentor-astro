---
/**
 * Click-to-zoom for images. Include <Lightbox /> once per page; it wires up
 * every image inside `.js-zoom` containers (the article body and the hero
 * featured image). If the image sits inside a link to a larger file, that
 * larger file is shown.
 */
---

<div class="lightbox" hidden>
  <button class="lightbox-close" type="button" aria-label="Close full view">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
  <figure class="lightbox-stage">
    <img class="lightbox-img" src="" alt="" />
    <figcaption class="lightbox-caption"></figcaption>
  </figure>
</div>

<script>
  const box = document.querySelector<HTMLElement>(".lightbox");
  if (box) {
    const img = box.querySelector<HTMLImageElement>(".lightbox-img")!;
    const caption = box.querySelector<HTMLElement>(".lightbox-caption")!;
    let lastFocus: HTMLElement | null = null;

    function open(src: string, alt: string) {
      lastFocus = document.activeElement as HTMLElement;
      img.src = src;
      img.alt = alt;
      caption.textContent = alt || "";
      caption.hidden = !alt;
      box.hidden = false;
      document.body.style.overflow = "hidden";
      box.querySelector<HTMLButtonElement>(".lightbox-close")?.focus();
    }

    function close() {
      box.hidden = true;
      img.src = "";
      document.body.style.overflow = "";
      lastFocus?.focus();
    }

    document.querySelectorAll<HTMLElement>(".js-zoom img").forEach((el) => {
      const image = el as HTMLImageElement;
      const link = image.closest("a");
      const isFileLink =
        link && /\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(link.href);
      image.classList.add("is-zoomable");

      const trigger = (event: Event) => {
        event.preventDefault();
        const full = isFileLink ? link!.href : image.currentSrc || image.src;
        open(full, image.alt || "");
      };

      image.addEventListener("click", trigger);
      if (isFileLink) link!.addEventListener("click", trigger);
    });

    box.addEventListener("click", (e) => {
      if (e.target === box || (e.target as HTMLElement).closest(".lightbox-close")) {
        close();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !box.hidden) close();
    });
  }
</script>
